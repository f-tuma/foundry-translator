{
  "name": "foundry-translate",
  "version": "0.14.9",
  "private": true,
  "type": "module",
  "description": "Reliable, glossary-aware adventure translation for Foundry VTT v14.",
  "repository": {
    "type": "git",
    "url": "https://github.com/f-tuma/foundry-translator.git"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "diagnose:chrome": "node scripts/diagnose-chrome-translator.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "linkedom": "^0.18.13",
    "playwright-core": "^1.61.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
