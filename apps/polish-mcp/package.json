{
  "name": "foundry-translation-polish-mcp",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs --metafile=dist/metafile.json && node ../../scripts/mcp-notices.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test",
    "start": "node dist/index.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "linkedom": "0.18.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@types/node": "^22.20.4",
    "esbuild": "0.28.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
