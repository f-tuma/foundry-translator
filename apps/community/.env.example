# Dokploy domain without scheme or trailing slash. Use a dedicated hostname.
COMMUNITY_HOST=translate.example.com
COMMUNITY_SCHEME=https
COMMUNITY_HTTPS=1
WEBLATE_ADMIN_NAME=admin
WEBLATE_ADMIN_EMAIL=admin@example.com
# Generate long unique values in your password manager. Never commit real secrets.
WEBLATE_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
