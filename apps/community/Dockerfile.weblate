FROM node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS engine
WORKDIR /workspace/apps/community
COPY apps/community/package*.json ./
RUN npm ci
COPY src /workspace/src
COPY apps/community ./
RUN npm run build:engine

FROM weblate/weblate:2026.9.1.2@sha256:f0be5b122b38d336e2b3575af1f5828884d482934a35d9dff83a3ec5efb66ae7
USER root
COPY --from=engine /usr/local/bin/node /usr/local/bin/node
COPY --from=engine /workspace/apps/community/engine.cjs /opt/ember/text-engine.cjs
COPY apps/community/weblate /usr/src/ember-bridge
RUN uv pip install --python /app/venv/bin/python --no-cache-dir --no-deps /usr/src/ember-bridge
ENV DJANGO_SETTINGS_MODULE=ember_bridge.settings
USER 1000
