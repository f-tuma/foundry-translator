    "build:engine": "esbuild scripts/engine.ts --bundle --platform=node --format=cjs --outfile=engine.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@fontsource/inter": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-start": "1.168.58",
    "diff": "9.0.0",
    "linkedom": "0.18.13",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/diff": "7.0.2",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "nitro": "3.0.260903-beta",
    "prettier": "3.9.9",
