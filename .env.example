# Community editor / compose.community.yml / Dokploy
# Copy to .env in this directory, or paste the values into Dokploy Environment.
# A dedicated hostname, without scheme or trailing slash.
COMMUNITY_HOST=translate.example.com
COMMUNITY_SCHEME=https
COMMUNITY_HTTPS=1

# Initial Weblate administrator. Generate unique passwords before first startup.
# Keep real credentials in .env or Dokploy, never in this example file.
WEBLATE_ADMIN_NAME=admin
WEBLATE_ADMIN_EMAIL=admin@example.com
WEBLATE_ADMIN_PASSWORD=
POSTGRES_PASSWORD=

# SMTP is used for invitations and password recovery. 587 + STARTTLS by default.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=
SMTP_PASSWORD=
